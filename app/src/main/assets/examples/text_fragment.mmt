<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<micromath xmlns:mmt="http://micromath.mkulesh.com">
  <formulaList documentVersion="2" author="Mikhail Kulesh" title="Example of headers" description="" textWidth="60" significantDigits="6" scale="0.74384" redefineAllowed="false">
    <text_fragment textStyle="chapter" numbering="true">
      <term key="text" text="Chapter: line 1&#10;Chapter: line 2" />
    </text_fragment>
    <text_fragment>
      <term key="text" text="paragraph: line 1&#10;paragraph: line 2" />
    </text_fragment>
