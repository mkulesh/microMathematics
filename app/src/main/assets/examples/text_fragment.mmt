    </text_fragment>
    <text_fragment textStyle="section" numbering="true">
      <term key="text" text="Section" />
    </text_fragment>
    <text_fragment textStyle="subsection" numbering="true">
      <term key="text" text="Subsection: line 1&#10;Subsection: line 2" />
    </text_fragment>
